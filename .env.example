# Copy this file to .env and enter your team's service settings.
# Blank required fields intentionally fail validation until filled in.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional: absolute path, or a path relative to the project folder.
DB_SSL_CA=certs/global-bundle.pem

# Set the shared MLflow HTTP(S) URL when PBI 6 is ready.
MLFLOW_TRACKING_URI=
